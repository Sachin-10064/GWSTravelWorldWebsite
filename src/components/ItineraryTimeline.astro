---
import type { DayItinerary, ActivityItem } from "../data/tripsData";

interface Props {
  itinerary: DayItinerary[];
}

const { itinerary } = Astro.props;

const materialIconMap: Record<string, string> = {
  flight: "flight_takeoff",
  market: "storefront",
  food: "restaurant",
  spa: "spa",
  yacht: "sailing",
  sunset: "wb_twilight",
  hiking: "hiking",
  hotel: "hotel",
  diving: "scuba_diving",
  turtle: "water",
  cave: "landscape",
  ruins: "castle",
  surf: "surfing",
  star: "auto_awesome",
};
---

<section id="itinerary-section" class="py-16 sm:py-24 bg-linear-to-b from-slate-100 via-slate-50 to-white text-slate-900 relative overflow-hidden select-none">
  <!-- Subtle organic background contour lines -->
  <div class="absolute inset-0 opacity-15 pointer-events-none text-cyan-600">
    <svg class="w-full h-full" viewBox="0 0 1000 1000" preserveAspectRatio="none" fill="none" stroke="currentColor">
      <path d="M-100,200 C300,100 400,600 1100,400 M-100,400 C300,300 400,800 1100,600 M-100,600 C300,500 400,900 1100,800" stroke-width="2" stroke-dasharray="8 8"/>
    </svg>
  </div>

  <div class="w-full px-4 sm:px-8 lg:px-16 relative z-10">
    
    <!-- Section Title Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <span class="text-xs font-black tracking-widest text-ocean uppercase bg-sky-100/90 px-4 py-1.5 rounded-full border border-sky-300/60 inline-block mb-3 shadow-xs">
        DAY BY DAY JOURNEY
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-['Outfit',sans-serif] tracking-wider uppercase text-slate-900 leading-tight">
        CURATED ITINERARY
      </h2>
      <div class="w-16 h-1 bg-ocean mx-auto my-4 rounded-full"></div>
      <p class="text-slate-600 font-serif italic text-base sm:text-lg">
        Designed for maximum comfort, immersive island exploration, and unforgettable memories.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div id="timeline-wrapper" class="relative">
      
      <!-- Deep Winding Vertical Connected Road Path (Desktop) -->
      <div id="road-container" class="hidden lg:block absolute left-1/2 top-4 bottom-4 w-72 sm:w-80 -translate-x-1/2 pointer-events-none z-10">
        <svg class="w-full h-full" viewBox="0 0 280 1000" preserveAspectRatio="none" fill="none">
          <!-- Outer Ocean Road Glow / Border -->
          <path
            id="itinerary-road-path"
            d="M 140 0 C 270 140, 10 360, 140 500 C 270 640, 10 860, 140 1000"
            stroke="#0284c7"
            stroke-opacity="0.3"
            stroke-width="18"
            stroke-linecap="round"
          />
          <!-- Asphalt Road Surface -->
          <path
            d="M 140 0 C 270 140, 10 360, 140 500 C 270 640, 10 860, 140 1000"
            stroke="#1e293b"
            stroke-width="10"
            stroke-linecap="round"
          />
          <!-- White Dashed Road Center Line -->
          <path
            d="M 140 0 C 270 140, 10 360, 140 500 C 270 640, 10 860, 140 1000"
            stroke="#ffffff"
            stroke-width="2.5"
            stroke-dasharray="8 8"
            stroke-linecap="round"
          />
        </svg>

        <!-- Un-stretched Safari SUV Car (HTML Element Overlay) -->
        <div id="itinerary-car-div" class="absolute top-0 left-0 -ml-5 -mt-6 w-10 h-12 pointer-events-none z-30">
          <svg viewBox="0 0 32 40" class="w-full h-full drop-shadow-[0_6px_12px_rgba(0,0,0,0.4)]">
            <!-- Car Body -->
            <rect x="7" y="3" width="18" height="34" rx="6" fill="#0284c7" stroke="#ffffff" stroke-width="1.8" />
            <!-- Windshield -->
            <rect x="10" y="8" width="12" height="6" rx="1.5" fill="#0f172a" />
            <!-- Sunroof -->
            <rect x="10" y="17" width="12" height="7" rx="1.5" fill="#1e293b" />
            <!-- Rear Window -->
            <rect x="10" y="27" width="12" height="4" rx="1" fill="#0f172a" />
            <!-- Headlights -->
            <circle cx="9" cy="4" r="1.8" fill="#fef08a" />
            <circle cx="23" cy="4" r="1.8" fill="#fef08a" />
            <!-- Wheels -->
            <rect x="4" y="6" width="3" height="7" rx="1.2" fill="#020617" />
            <rect x="25" y="6" width="3" height="7" rx="1.2" fill="#020617" />
            <rect x="4" y="27" width="3" height="7" rx="1.2" fill="#020617" />
            <rect x="25" y="27" width="3" height="7" rx="1.2" fill="#020617" />
          </svg>
        </div>
      </div>

      <!-- Days List -->
      <div class="space-y-16 lg:space-y-16">
        {itinerary.map((day, index) => {
          const isEven = index % 2 === 0;

          return (
            <div class="relative group">
              
              <!-- Central Floating Day Badge (Desktop) -->
              <div class="hidden lg:flex absolute left-1/2 top-4 -translate-x-1/2 z-20 flex-col items-center justify-center">
                <div class="w-14 h-14 rounded-2xl bg-white border-2 border-ocean shadow-md flex flex-col items-center justify-center text-slate-900 transform group-hover:scale-110 transition-transform duration-300">
                  <span class="text-[9px] font-black tracking-widest text-ocean uppercase leading-none">DAY</span>
                  <span class="text-lg font-black leading-none mt-0.5">{day.dayNumber}</span>
                </div>
              </div>

              <!-- Main Grid Row (Spans Full Screen Width) -->
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-40 items-center">
                
                {/* Mobile Day Badge */}
                <div class="flex lg:hidden items-center gap-3 mb-2">
                  <div class="w-11 h-11 rounded-xl bg-ocean text-white flex flex-col items-center justify-center font-black shadow-md">
                    <span class="text-[9px] tracking-widest uppercase">DAY</span>
                    <span class="text-sm font-black leading-none">{day.dayNumber}</span>
                  </div>
                  <span class="text-xs font-bold tracking-widest text-ocean uppercase">
                    DAY {day.dayNumber} ITINERARY
                  </span>
                </div>

                {/* Itinerary Text Content */}
                <div class={`order-1 ${isEven ? 'lg:order-1 lg:pr-8' : 'lg:order-2 lg:pl-8'}`}>
                  <div class="space-y-3">
                    
                    <!-- Day Header Title -->
                    <h3 class="text-xl sm:text-2xl lg:text-3xl font-black font-['Outfit',sans-serif] tracking-wide text-slate-900 mb-3 group-hover:text-ocean transition-colors">
                      {day.dayTitle}
                    </h3>

                    <!-- Activities List -->
                    <div class="space-y-3">
                      {day.activities.map((act) => (
                        <div class="flex items-start gap-3 group/item">
                          <!-- Activity Icon Badge -->
                          <div class="w-8 h-8 rounded-lg bg-sky-100 border border-sky-200 text-ocean shrink-0 flex items-center justify-center mt-0.5 group-hover/item:bg-ocean group-hover/item:text-white transition-all duration-300">
                            <span class="material-symbols-outlined text-base">
                              {materialIconMap[act.icon] || "explore"}
                            </span>
                          </div>

                          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-sans pt-0.5">
                            {act.description}
                          </p>
                        </div>
                      ))}
                    </div>

                  </div>
                </div>

                {/* Photo Gallery Collage (Aspect Ratio-Based Grid) */}
                <div class={`order-2 ${isEven ? 'lg:order-2' : 'lg:order-1'}`}>
                  <div class="grid grid-cols-2 gap-2.5 max-w-sm sm:max-w-md mx-auto lg:max-w-none">
                    {day.images.map((img, imgIdx) => (
                      <div
                        class={`relative rounded-xl overflow-hidden shadow-md group/img border border-white/10 ${
                          day.images.length % 2 !== 0 && imgIdx === 0
                            ? 'col-span-2 aspect-[16/9]'
                            : 'aspect-[4/3]'
                        }`}
                      >
                        <img
                          src={img.url}
                          alt={img.alt}
                          class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-700 ease-out"
                          loading="lazy"
                        />
                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300 flex items-end p-2.5">
                          <span class="text-[11px] text-white font-medium truncate">{img.alt}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<!-- Scroll-Driven Car Animation Script -->
<script>
  function initRoadCarAnimation() {
    const wrapper = document.getElementById("timeline-wrapper");
    const roadContainer = document.getElementById("road-container");
    const path = document.getElementById("itinerary-road-path") as SVGPathElement | null;
    const carDiv = document.getElementById("itinerary-car-div") as HTMLDivElement | null;

    if (!wrapper || !roadContainer || !path || !carDiv) return;

    const totalLength = path.getTotalLength();

    function updateCarPosition() {
      if (!wrapper || !roadContainer || !path || !carDiv) return;
      const rect = wrapper.getBoundingClientRect();
      const containerRect = roadContainer.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Start scrolling right when Day 1 (top of wrapper) reaches ~45% of viewport
      const startY = rect.top - windowHeight * 0.45;
      const totalDistance = rect.height - windowHeight * 0.5;
      
      let progress = -startY / totalDistance;
      progress = Math.max(0, Math.min(1, progress));

      // Calculate position along SVG path
      const currentLength = progress * totalLength;
      const point = path.getPointAtLength(currentLength);
      
      // Convert SVG viewBox coordinates (0..280 x 0..1000) to actual pixel offset inside roadContainer
      const pixelX = (point.x / 280) * containerRect.width;
      const pixelY = (point.y / 1000) * containerRect.height;

      // Tangent angle calculation for smooth car rotation
      const nextLength = Math.min(totalLength, currentLength + 4);
      const nextPoint = path.getPointAtLength(nextLength);
      const nextPixelX = (nextPoint.x / 280) * containerRect.width;
      const nextPixelY = (nextPoint.y / 1000) * containerRect.height;

      const angle = Math.atan2(nextPixelY - pixelY, nextPixelX - pixelX) * (180 / Math.PI);

      carDiv.style.transform = `translate(${pixelX.toFixed(2)}px, ${pixelY.toFixed(2)}px) rotate(${(angle + 90).toFixed(2)}deg)`;
    }

    window.addEventListener("scroll", updateCarPosition, { passive: true });
    window.addEventListener("resize", updateCarPosition);
    updateCarPosition();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRoadCarAnimation);
  } else {
    initRoadCarAnimation();
  }
  document.addEventListener("astro:page-load", initRoadCarAnimation);
</script>
